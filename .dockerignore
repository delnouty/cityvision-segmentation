# Keep the build context small. NOTE: backend/model/*.pth and data/samples/ are
# intentionally NOT ignored — they are baked into the images.
.git
.github
.venv
**/__pycache__
*.pyc
.pytest_cache
.mypy_cache

# Large / irrelevant to the images
data/cityscapes
mlflow.db
mlruns
mlartifacts
notebooks
results
doc
*.png

# Manual checkpoint backups kept before a re-training run. Deliberately outside
# backend/model/ so they are not baked into the images; excluded here as well so
# they do not inflate the build context.
model_backups
