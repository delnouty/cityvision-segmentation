# ─── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# ─── Virtual environments ───────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Editors ────────────────────────────────────────────────────────────────
# keep the shared Pylance extraPaths config, ignore the rest of .vscode/
.vscode/*
!.vscode/settings.json
*.swp
.idea/

# ─── Jupyter ────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── MLflow ─────────────────────────────────────────────────────────────────
mlflow.db
mlruns/
mlartifacts/

# ─── Datasets (Cityscapes — large, do not commit) ───────────────────────────
data/*
# …but DO commit the small curated sample set used by the Streamlit frontend.
!data/samples/

# ─── Model checkpoints / weights ────────────────────────────────────────────
*.pth
*.pt
*.ckpt
*.onnx

# ─── Logs & caches ──────────────────────────────────────────────────────────
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── OS cruft ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
~BROMIUM/
**/~BROMIUM/

# ─── Generated docs (LaTeX build output — regenerate with pdflatex) ──────────
doc/*.pdf
doc/*.aux
doc/*.out
doc/*.toc

# ─── Generated visualizations / outputs ─────────────────────────────────────
results/
